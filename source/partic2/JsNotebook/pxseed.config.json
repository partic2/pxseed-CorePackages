{
  "loaders": [
    {
      "name":"copyFiles",
      "include":["prism/*.js","prism/*.css"]
    },{
      "name": "typescript"
    }
  ],
  "clean":{
    "include": [
      "**/*.js","prism/*.js","prism/*.css"
    ],
    "excludeRegexp": [
      "^workspace/"
    ]
  },
  "name": "partic2/JsNotebook",
  "extra":{
    "partic2/packageManager/registry":{
      "webui":{
        "entry":"./index",
        "label":"Js Notebook",
        "icon":"/partic2/pxseedMedia1/icons/sidebar.svg"
      }
    }
  }
}