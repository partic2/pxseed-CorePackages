{
  "loaders": [
    {
      "name": "typescript"
    },{
      "name":"rollup",
      "entryModules":["buffer","isomorphic-git"],
      "noImplicitExternal":["buffer","isomorphic-git"]
    },{
      "name": "pxseedjs:partic2/CodeRunner/pxseedLoader.addAsyncHookPxseedLoader"
    }
  ],
  "clean":{
    "include": [
      "**/*.js","__temp/**/*"
    ],
    "excludeRegexp": [
      "^data/"
    ]
  },
  "name": "partic2/packageManager"
}